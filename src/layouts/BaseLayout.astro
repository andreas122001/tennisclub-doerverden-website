---
// BaseLayout wraps every page. Import it, pass a title, and put your content inside:
//   <BaseLayout title="My Page"> ... </BaseLayout>
// The <slot /> below is where that content gets inserted.

import '../styles/global.css';
import contactData from '../data/contact.json'; // Footer reads live from contact.json

interface Props {
  title: string;
  description?: string; // Used as the meta description for SEO
}

const { title, description = 'Willkommen beim Tennisclub' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Startseite' },
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/preise', label: 'Beiträge' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/kontakt', label: 'Kontakt' },
  { href: '/impressum', label: 'Impressum' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Tennisclub</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-800">

    <!-- sticky: header scrolls with the page and stays on top.
         backdrop-blur-sm: frosted-glass effect when content scrolls behind it. -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center gap-x-6 gap-y-2 h-16">
        <a href="/" class="font-bold text-lg text-slate-900 mr-auto tracking-tight">
          TC Dörverden
        </a>
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors',
              // Exact match so /ueber-uns doesn't highlight on a hypothetical /ueber-uns/sub-page
              currentPath == link.href
                ? 'text-emerald-700'        // active
                : 'text-slate-600 hover:text-slate-900',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <!-- flex-1 makes main grow to fill the space, pushing the footer to the bottom -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer content is pulled from src/data/contact.json so editing
         that file (or via CMS) also updates the footer automatically. -->
    <footer class="bg-slate-900 text-slate-300 mt-auto">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-8">
          <div>
            <p class="font-semibold text-white mb-2">Adresse</p>
            <!-- not-italic: browsers render <address> in italic by default -->
            <address class="not-italic text-sm leading-relaxed">
              {contactData.address},<br />
              {contactData.city}<br />
            </address>
                            {contactData.email && (
                    <a href={`mailto:${contactData.email}`} class="text-sm hover:text-white transition-colors">
                      {contactData.email}
                    </a>
                )}
          </div>
          <div>
            <contact class="text-sm space-y-1">
              <div>
                <p class="font-semibold text-white mb-2">Telefon  </p>
                <div class="flex">
                  <p class="text-slate-400 w-20 shrink-0">Tennis</p>
                  <a href={`tel:${contactData.phone_tennis}`} class="hover:text-white transition-colors text-right">
                    {contactData.phone_tennis}
                  </a>
                </div>
                <div class="flex">
                  <p class="text-slate-400 w-20 shrink-0">Boule</p>
                  <a href={`tel:${contactData.phone_boule}`} class="hover:text-white transition-colors text-right">
                    {contactData.phone_boule}
                  </a>
                </div>
              </div>
              <div>

              </div>
          </div>
          <div>
            <p class="font-semibold text-white mb-2">Öffnungszeiten</p>
            <dl class="text-sm space-y-1">
              {contactData.openingHours.map(row => (
                <div class="flex gap-3">
                  <dt class="text-slate-400 w-20 shrink-0">{row.days}</dt>
                  <dd>{row.hours}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div>
            <p class="font-semibold text-white mb-2">Rechtliches</p>
            <ul class="text-sm space-y-1">
              <li><a href="/impressum" class="hover:text-white transition-colors">Impressum</a></li>
              <li><a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-slate-700 mt-8 pt-6 text-xs text-slate-500">
          &copy; {new Date().getFullYear()} Tennisclub. Alle Rechte vorbehalten.
        </div>
      </div>
    </footer>

  </body>
</html>
