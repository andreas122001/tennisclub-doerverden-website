---
// BaseLayout wraps every page. Import it, pass a title, and put your content inside:
//   <BaseLayout title="My Page"> ... </BaseLayout>
// The <slot /> below is where that content gets inserted.

import '../styles/global.css';
import contactData from '../data/contact.json'; // Footer reads live from contact.json

interface Props {
  title: string;
  description?: string; // Used as the meta description for SEO
}

const { title, description = 'Willkommen beim Tennisclub' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Startseite' },
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/preise', label: 'Beiträge' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/kontakt', label: 'Kontakt' },
  { href: '/impressum', label: 'Impressum' },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Tennisclub</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-800">

    <!-- ─── Header ────────────────────────────────────────────────────────────
         sticky: stays at top as the page scrolls beneath it.
         backdrop-blur-sm: frosted-glass effect on the white background.       -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200">

      <!-- Main nav bar (logo + desktop links + hamburger button) -->
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center h-16">
        <a href="/" class="font-bold text-lg text-slate-900 mr-auto tracking-tight">
          TC Dörverden
        </a>

        <!-- Desktop links — hidden on mobile, shown from md breakpoint up -->
        <div class="hidden md:flex items-center gap-x-6">
          {navLinks.map(link => (
            <a
              href={link.href}
              class:list={[
                'text-sm font-medium transition-colors',
                // Exact match so /ueber-uns doesn't highlight on a hypothetical /ueber-uns/sub-page
                currentPath == link.href
                  ? 'text-emerald-700'
                  : 'text-slate-600 hover:text-slate-900',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>

        <!-- Hamburger button — visible on mobile only, hidden from md breakpoint up -->
        <button
          id="nav-toggle"
          class="md:hidden p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
          aria-label="Navigation öffnen"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <!-- Hamburger icon (three lines) — shown when menu is closed -->
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- X icon — shown when menu is open -->
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile dropdown menu — hidden by default, toggled by the button above.
           md:hidden ensures it can never appear on desktop even if JS misfires.  -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white">
        <nav class="max-w-6xl mx-auto px-4 py-2 flex flex-col">
          {navLinks.map(link => (
            <a
              href={link.href}
              class:list={[
                'py-3 text-sm font-medium border-b border-slate-50 last:border-0 transition-colors',
                currentPath == link.href
                  ? 'text-emerald-700'
                  : 'text-slate-700 hover:text-slate-900',
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

    </header>
    <!-- ─── End Header ─────────────────────────────────────────────────────── -->

    <!-- flex-1 makes main grow to fill the space, pushing the footer to the bottom -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer content is pulled from src/data/contact.json so editing
         that file (or via CMS) also updates the footer automatically. -->
    <footer class="bg-slate-900 text-slate-300 mt-auto">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-8">
          <div>
            <p class="font-semibold text-white mb-2">Adresse</p>
            <!-- not-italic: browsers render <address> in italic by default -->
            <address class="not-italic text-sm leading-relaxed">
              {contactData.address},<br />
              {contactData.city}<br />
            </address>
                            {contactData.email && (
                    <a href={`mailto:${contactData.email}`} class="text-sm hover:text-white transition-colors">
                      {contactData.email}
                    </a>
                )}
          </div>
          <div>
            <contact class="text-sm space-y-1">
              <div>
                <p class="font-semibold text-white mb-2">Telefon  </p>
                <div class="flex">
                  <p class="text-slate-400 w-20 shrink-0">Tennis</p>
                  <a href={`tel:${contactData.phone_tennis}`} class="hover:text-white transition-colors text-right">
                    {contactData.phone_tennis}
                  </a>
                </div>
                <div class="flex">
                  <p class="text-slate-400 w-20 shrink-0">Boule</p>
                  <a href={`tel:${contactData.phone_boule}`} class="hover:text-white transition-colors text-right">
                    {contactData.phone_boule}
                  </a>
                </div>
              </div>
              <div>

              </div>
          </div>
          <div>
            <p class="font-semibold text-white mb-2">Öffnungszeiten</p>
            <dl class="text-sm space-y-1">
              {contactData.openingHours.map(row => (
                <div class="flex gap-3">
                  <dt class="text-slate-400 w-20 shrink-0">{row.days}</dt>
                  <dd>{row.hours}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div>
            <p class="font-semibold text-white mb-2">Rechtliches</p>
            <ul class="text-sm space-y-1">
              <li><a href="/impressum" class="hover:text-white transition-colors">Impressum</a></li>
              <li><a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-slate-700 mt-8 pt-6 text-xs text-slate-500">
          &copy; {new Date().getFullYear()} Tennisclub. Alle Rechte vorbehalten.
        </div>
      </div>
    </footer>

  </body>
</html>

<!-- ─── Mobile nav toggle script ──────────────────────────────────────────────
     Astro bundles this as a JS module (runs deferred, after the DOM is ready).
     Kept here rather than a separate file since it only serves this layout.    -->
<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
  const menu   = document.getElementById('mobile-menu') as HTMLElement;
  const iconOpen  = document.getElementById('icon-open')  as HTMLElement;
  const iconClose = document.getElementById('icon-close') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const opening = menu.classList.contains('hidden');
    menu.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(opening));
    toggle.setAttribute('aria-label', opening ? 'Navigation schließen' : 'Navigation öffnen');
  });

  // Close the menu automatically when the user taps a link inside it
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Navigation öffnen');
    });
  });
</script>