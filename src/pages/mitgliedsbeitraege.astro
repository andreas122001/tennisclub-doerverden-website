---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

// All pricing data (title, intro, table) lives in frontmatter; the body is the conclusion.
const entry = (await getEntry('pages', 'pricing'))!;
const { Content } = await render(entry);

// Cast to a typed shape — the pages schema uses catchall() so extra fields are untyped
type PricingRow = { type: string; price: string; note?: string };
type PricingData = { title: string; intro?: string; table: PricingRow[] };
const data = entry.data as unknown as PricingData;
---

<BaseLayout title={data.title}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold text-slate-900 mb-4">{data.title}</h1>
    {data.intro && (
      <p class="text-slate-600 mb-8">{data.intro}</p>
    )}

    <!-- overflow-x-auto lets the table scroll horizontally on narrow screens
         instead of breaking the page layout -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="py-3 pr-6 text-sm font-semibold text-slate-700">Mitgliedschaft</th>
            <th class="py-3 pr-6 text-sm font-semibold text-slate-700">Beitrag</th>
            <th class="py-3 text-sm font-semibold text-slate-700">Anmerkung</th>
          </tr>
        </thead>
        <tbody>
          {data.table.map(row => (
            <tr class="border-b border-slate-100">
              <td class="py-3 pr-6 text-slate-800">{row.type}</td>
              <td class="py-3 pr-6 text-right font-medium text-slate-900">{row.price}</td>
              <td class="py-3 text-slate-500 text-sm">{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Conclusion rendered from the markdown body of pricing.md -->
    <div class="prose prose-slate max-w-none mt-8">
      <Content />
    </div>
  </div>
</BaseLayout>