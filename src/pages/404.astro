---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">

    <p class="text-8xl font-bold text-slate-200 mb-4 select-none">404</p>

    <h1 class="text-2xl font-bold text-slate-900 mb-3">Seite nicht gefunden</h1>
    <p class="text-slate-500 mb-10">
      Die gesuchte Seite existiert leider nicht.<br />
      Vielleicht hilft ein Blick auf unsere Startseite weiter.
    </p>

    <a
      href="/"
      class="inline-block px-6 py-3 bg-emerald-700 text-white font-medium rounded-lg hover:bg-emerald-800 transition-colors"
    >
      Zur Startseite
    </a>

  </div>
</BaseLayout>
