---
import BaseLayout from '../layouts/BaseLayout.astro';
import contactData from '../data/contact.json'; // Content managed via CMS → src/data/contact.json
---

<BaseLayout title="Kontakt">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold text-slate-900 mb-8">Kontakt</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3">Adresse</h2>
        <!-- not-italic: browsers render <address> in italic by default — this resets it -->
        <address class="not-italic text-slate-800 leading-relaxed">
          {contactData.address}<br />
          {contactData.city}
        </address>

        {contactData.phone && (
          <div class="mt-6">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">Telefon</h2>
            <!-- tel: makes the number tappable on mobile -->
            <a href={`tel:${contactData.phone}`} class="text-slate-800 hover:text-emerald-700 transition-colors">
              {contactData.phone}
            </a>
          </div>
        )}

        {contactData.email && (
          <div class="mt-6">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-2">E-Mail</h2>
            <a href={`mailto:${contactData.email}`} class="text-slate-800 hover:text-emerald-700 transition-colors">
              {contactData.email}
            </a>
          </div>
        )}
      </div>

      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3">Öffnungszeiten</h2>
        <!-- <dl> (description list) is the semantically correct element for term/value pairs -->
        <dl class="space-y-1">
          {contactData.openingHours.map(row => (
            <div class="flex gap-4">
              <dt class="text-slate-500 w-24 shrink-0">{row.days}</dt>
              <dd class="text-slate-800">{row.hours}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</BaseLayout>
