---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

// The ! asserts this entry always exists — if impressum.md is deleted, the build will crash
const entry = (await getEntry('pages', 'impressum'))!;
// render() converts the Markdown body into a renderable component.
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold text-slate-900 mb-8">{entry.data.title}</h1>
    <!-- prose: styles the rendered Markdown -->
    <div class="prose prose-slate max-w-none">
      <Content />
    </div>
  </div>
</BaseLayout>
