---
import BaseLayout from '../layouts/BaseLayout.astro';
import pricingData from '../data/pricing.json'; // Content managed via CMS → src/data/pricing.json
---

<BaseLayout title={pricingData.title}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-3xl font-bold text-slate-900 mb-4">{pricingData.title}</h1>
    {pricingData.intro && (
      <p class="text-slate-600 mb-8">{pricingData.intro}</p>
    )}

    <!-- overflow-x-auto lets the table scroll horizontally on narrow screens
         instead of breaking the page layout -->
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="py-3 pr-6 text-sm font-semibold text-slate-700">Mitgliedschaft</th>
            <th class="py-3 pr-6 text-sm font-semibold text-slate-700">Beitrag</th>
            <th class="py-3 text-sm font-semibold text-slate-700">Anmerkung</th>
          </tr>
        </thead>
        <tbody>
          {pricingData.table.map(row => (
            <tr class="border-b border-slate-100">
              <td class="py-3 pr-6 text-slate-800">{row.type}</td>
              <td class="py-3 pr-6 text-right font-medium text-slate-900">{row.price}</td>
              <td class="py-3 text-slate-500 text-sm">{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {pricingData.conclusion && (
      <p class="mt-8 text-slate-600 mb-8">{pricingData.conclusion}</p>
    )}
  </div>
</BaseLayout>
