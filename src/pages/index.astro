---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import homeData from '../data/home.json';

const allPosts: CollectionEntry<'posts'>[] = await getCollection('posts');
// Pinned posts float to the top, then most recent first within each group
const sorted = allPosts.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
const pinnedPosts  = sorted.filter(p => p.data.pinned);
const recentPosts  = sorted.filter(p => !p.data.pinned).slice(0, 3);
const homePosts    = [...pinnedPosts, ...recentPosts];
const hasMorePosts = allPosts.length > homePosts.length;

const allEvents: CollectionEntry<'events'>[] = await getCollection('events');
const now = new Date();
// Only upcoming events, sorted earliest first
const upcomingEvents = allEvents
  .filter(e => e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

// Slash geometry constants — tweak to taste
const sep = homeData.heroSeparation;   // 0–100: position of the slash centre
const slant = homeData.heroSeparationSlant;  // how many % the diagonal deviates from vertical
const half = 1.5;                       // half-width of the separator stripe (%)
---

<BaseLayout title="Startseite" description={homeData.heroSubtitle}>

  <!-- Split hero -->
  <section
    class="relative flex items-center justify-center min-h-[45vh] bg-slate-900 overflow-hidden"
    style={`--sep:${sep}; --slant:${slant}; --half:${half}`}
  >
    <!-- Left image — clipped to the left of the slash -->
    {homeData.heroImageLeft && (
      <Image
        src={homeData.heroImageLeft}
        alt=""
        width={1920}
        height={1080}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover opacity-60"
        style={homeData.heroImageRight
          ? "clip-path: polygon(0 0, calc(var(--sep)*1% + var(--slant)*1%) 0, calc(var(--sep)*1% - var(--slant)*1%) 100%, 0 100%)"
          : undefined}
      />
    )}

    <!-- Right image — clipped to the right of the slash -->
    {homeData.heroImageRight && (
      <Image
        src={homeData.heroImageRight}
        alt=""
        width={1920}
        height={1080}
        loading="eager"
        class="absolute inset-0 w-full h-full object-cover opacity-60"
        style="clip-path: polygon(calc(var(--sep)*1% + var(--slant)*1%) 0, 100% 0, 100% 100%, calc(var(--sep)*1% - var(--slant)*1%) 100%)"
      />
    )}

    <!-- Diagonal separator stripe -->
    {homeData.heroImageRight && (
      <div
        class="absolute inset-0 z-10 bg-white/50"
        style="clip-path: polygon(
          calc(var(--sep)*1% + var(--slant)*1% - var(--half)*1%) 0,
          calc(var(--sep)*1% + var(--slant)*1% + var(--half)*1%) 0,
          calc(var(--sep)*1% - var(--slant)*1% + var(--half)*1%) 100%,
          calc(var(--sep)*1% - var(--slant)*1% - var(--half)*1%) 100%
        )"
      />
    )}

    <!-- Text overlay -->
    <div class="relative z-20 text-center px-4 py-16">
      <p class="text-sm font-semibold text-white/60 uppercase tracking-widest mb-3">Willkommen beim</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">
        {homeData.heroTitle}
      </h1>
      {homeData.heroSubtitle && (
        <p class="text-lg sm:text-xl text-slate-200 max-w-xl mx-auto">
          {homeData.heroSubtitle}
        </p>
      )}
    </div>
  </section>

  <!-- ── CTA strip — shown only when ctaEnabled is true in home.json ────────── -->
  {homeData.ctaEnabled && (
    <section class="bg-emerald-50 border-y border-emerald-100">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
        <h2 class="text-2xl font-bold text-slate-900 mb-2">{homeData.ctaTitle}</h2>
        {homeData.ctaText && (
          <p class="text-slate-600 mb-6 max-w-md mx-auto">{homeData.ctaText}</p>
        )}
        <a href="/kontakt" class="inline-block px-6 py-3 bg-emerald-700 text-white font-semibold rounded-lg hover:bg-emerald-800 transition-colors">
          Mitglied werden →
        </a>
      </div>
    </section>
  )}

  <!-- ── Main content: posts feed (left) + events sidebar (right) ─────────── -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

      <!-- Posts feed — 2/3 width on desktop -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Aktuelles</h2>

        {homePosts.length === 0 ? (
          <p class="text-slate-500">Noch keine Beiträge vorhanden.</p>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
            {homePosts.map((post: CollectionEntry<'posts'>) => (
              <article class="flex flex-col">
                {post.data.coverImage && (
                  <a href={`/posts/${post.id}`} tabindex="-1" aria-hidden="true">
                    <img
                      src={post.data.coverImage}
                      alt=""
                      class="w-full h-48 object-cover rounded-lg mb-4 hover:opacity-90 transition-opacity"
                    />
                  </a>
                )}
                {post.data.pinned && (
                  <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded self-start mb-1">
                    Angepinnt
                  </span>
                )}
                <h3 class="text-lg font-semibold text-slate-900 mb-1">
                  <a href={`/posts/${post.id}`} class="hover:text-emerald-700 transition-colors">
                    {post.data.title}
                  </a>
                </h3>
                <time class="text-sm text-slate-400 mb-2">
                  {post.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}
                </time>
                {post.data.description && (
                  <p class="text-slate-600 text-sm flex-1">{post.data.description}</p>
                )}
                <a href={`/posts/${post.id}`} class="mt-3 text-sm font-medium text-emerald-700 hover:underline">
                  Weiterlesen →
                </a>
              </article>
            ))}
          </div>
        )}

        {hasMorePosts && (
          <div class="mt-10">
            <a href="/posts" class="text-sm font-medium text-emerald-700 hover:underline">
              Alle Beiträge ansehen →
            </a>
          </div>
        )}
      </div>

      <!-- ── Events sidebar (takes up 1/3 on desktop) ───────────────────── -->
      <aside>
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Veranstaltungen</h2>

        {upcomingEvents.length === 0 ? (
          <p class="text-slate-500 text-sm">Keine bevorstehenden Veranstaltungen.</p>
        ) : (
          <ul class="space-y-4">
            {upcomingEvents.map(event => (
              <li class="border-l-2 border-emerald-500 pl-4">
                <time class="text-xs font-semibold text-emerald-700 uppercase tracking-wide">
                  {event.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}
                </time>
                <p class="font-semibold text-slate-900 mt-0.5">{event.data.title}</p>
                {event.data.location && (
                  <p class="text-xs text-slate-400 mt-0.5">{event.data.location}</p>
                )}
                {event.data.description && (
                  <p class="text-sm text-slate-600 mt-1">{event.data.description}</p>
                )}
                {event.data.link && (
                  <a href={event.data.link} class="text-xs font-medium text-emerald-700 hover:underline mt-1 inline-block">
                    Mehr erfahren →
                  </a>
                )}
              </li>
            ))}
          </ul>
        )}
      </aside>

    </div>
  </section>

</BaseLayout>
